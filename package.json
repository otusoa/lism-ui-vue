{
  "name": "lism-ui-vue",
  "version": "0.1.2-alpha.10",
  "private": false,
  "license": "MIT",
  "author": "Eita Kobayashi",
  "repository": {
    "type": "git",
    "url": "https://github.com/otusoa/lism-ui-vue"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./composables": {
      "types": "./dist/composables.d.ts",
      "import": "./dist/composables.js"
    },
    "./style": "./dist/lism-ui-vue.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/",
    "release": "changelogen --dir . --release --bump --push",
    "release:alpha": "changelogen --dir . --release --bump --prerelease alpha --push",
    "release:beta": "changelogen --dir . --release --bump --prerelease beta --push",
    "release:rc": "changelogen --dir . --release --bump --prerelease rc --push",
    "tag:push": "git push --follow-tags",
    "test": "vitest",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "lism-css": "^0.26.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.59.0",
    "@nuxt/schema": "^4.5.2",
    "@phosphor-icons/vue": "^2.2.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.0",
    "changelogen": "^0.6.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.79.0",
    "eslint-plugin-vue": "^10.10.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.0",
    "lefthook": "^2.1.10",
    "npm-run-all2": "^9.0.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^31.1.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "5.1.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue": "^3.5.41",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
